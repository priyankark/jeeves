# Jev decision engine (TypeSafe System One API).
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Keys stay in this local server environment, never in the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Any local OpenAI-compatible chat-completions server (Ollama, vLLM, LM Studio).
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=
# Opt in to the installed Codex CLI. Runs with a read-only sandbox.
ENABLE_CODEX=false
# Comma-separated exact origins allowed for live HTTP action nodes.
ACTION_ALLOWED_ORIGINS=
