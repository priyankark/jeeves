{
  "intro": {
    "sha256": "6014ec0036b7ceb9156dabdc1bc5792bc00dcc6a99a779efb8fa720e1feb541a",
    "cues": [
      {
        "start": 0.0,
        "end": 4.15,
        "text": "Here's Jeeves, an open source app for productivity workflows."
      },
      {
        "start": 4.48,
        "end": 6.95,
        "text": "Build a process once and use it again."
      }
    ]
  },
  "01-workflow": {
    "sha256": "3d05d5c6a9e82cc80f04e61a6dcb7b91a6eb0aca3f33c661a85d365bc60d3720",
    "cues": [
      {
        "start": 0.0,
        "end": 2.55,
        "text": "This workflow sorts incoming requests."
      },
      {
        "start": 2.94,
        "end": 6.75,
        "text": "Each agent has a job, and you can open any step to see what happened."
      }
    ]
  },
  "02-decision": {
    "sha256": "ef3026c7d57ec8bb40447e34488f44f6abfc88d3801827de5509c41deb39e041",
    "cues": [
      {
        "start": 0.0,
        "end": 3.65,
        "text": "Jev recognizes an outage and sends it to the incident agent."
      },
      {
        "start": 3.9,
        "end": 7.77,
        "text": "The decision shows its answer, confidence, and chosen route."
      }
    ]
  },
  "03-waiting": {
    "sha256": "4b7528ab85f87e78d34729149915c3cf7d21967f1cad92ae39235728caab7dcc",
    "cues": [
      {
        "start": 0.0,
        "end": 4.41,
        "text": "When a request is missing details, Jeeves will ask you a question."
      },
      {
        "start": 4.66,
        "end": 8.07,
        "text": "The workflow saves its progress and waits until you answer."
      }
    ]
  },
  "04-answer": {
    "sha256": "ad756b0f6f68232eb7027c1490ae9a5d9a949c35f76380f65eee5682e0737136",
    "cues": [
      {
        "start": 0.0,
        "end": 1.93,
        "text": "Add the details and submit."
      },
      {
        "start": 2.3,
        "end": 4.01,
        "text": "The workflow picks up from where it stopped."
      }
    ]
  },
  "05-result": {
    "sha256": "e9c88dd70409a25ef4a98f8a935e7350c0ac7704fb47a2ae4ce6e3c1071ce207",
    "cues": [
      {
        "start": 0.0,
        "end": 4.91,
        "text": "Now you have an action brief, a suggested fix, and a draft reply to review."
      },
      {
        "start": 5.28,
        "end": 6.89,
        "text": "Nothing has been sent to the customer."
      }
    ]
  },
  "06-export": {
    "sha256": "b4d3e38d77f51646b21c2d9951d1212af4dcb957424273425f58a690b8fc46f5",
    "cues": [
      {
        "start": 0.0,
        "end": 4.97,
        "text": "Save this workflow for the next request, or export it as a skill to use elsewhere."
      }
    ]
  },
  "outro": {
    "sha256": "72a9ca2e6b5b6a087c5a7df9b1d03d6da52802c349f632d48ab0a81fbc3502bc",
    "cues": [
      {
        "start": 0.0,
        "end": 2.21,
        "text": "Try Jeeves at get Jeeves dot app."
      },
      {
        "start": 2.34,
        "end": 5.77,
        "text": "Start with the built-in example, no API key needed."
      }
    ]
  }
}
