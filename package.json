{
  "name": "jeeves",
  "private": true,
  "version": "0.1.0-preview.11",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/build-runtime.mjs",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop": "npm run build && electron electron/main.cjs",
    "format": "prettier --write src shared server tests *.ts electron/*.cjs README.md",
    "desktop:open": "electron electron/main.cjs --dev",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs --dev\"",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "check:catalog": "node --import tsx scripts/check-catalog.mjs",
    "test:personas": "vitest run tests/simulated-users.test.ts tests/browser-depth.test.ts tests/http-pagination.test.ts && playwright test tests/browser/personas.spec.ts tests/browser/depth.spec.ts",
    "simulate:live": "node --import tsx scripts/simulate-live-users.ts",
    "pretest": "npm run build:runtime && node --check runtime/server.mjs",
    "simulate:live:depth": "node --import tsx scripts/simulate-live-depth.ts",
    "package:installer": "npm run package:desktop && node scripts/build-installers.mjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "launch:kit": "node marketing/launch/build-kit.mjs",
    "check:launch": "node marketing/launch/check-kit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "@xyflow/react": "^12.12.0",
    "cron-parser": "^5.10.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@electron/osx-sign": "2.7.0",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "description": "Local-first workflow orchestration with chat, Jev decisions, and portable agent skills",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/priyankark/jeeves",
  "author": "Jeeves contributors"
}
